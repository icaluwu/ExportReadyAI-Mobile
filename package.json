{
  "name": "exportready-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "npx -p typescript tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const navDir=p.join('node_modules','@react-navigation','elements','lib','module','assets');if(fs.existsSync(navDir)){['close-icon.png','close-icon@1x.png','close-icon@2x.png','close-icon@3x.png'].forEach(f=>{const src=p.join(navDir,f.replace('close-icon','clear-icon')),dst=p.join(navDir,f);if(fs.existsSync(src)&&!fs.existsSync(dst))fs.copyFileSync(src,dst);});}\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@opentelemetry/api": "^1.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/types": "^7.25.2",
    "@expo/cli": "~0.22.10",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "^5.3.3"
  },
  "private": true
}
