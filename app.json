{
  "expo": {
    "name": "ExportReadyAI",
    "slug": "mobile-app-export-ready-ai",
    "owner": "exportreadyai",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "exportready",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exportready.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.exportready.mobile"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f553107-a36f-4cff-91b7-f716ed4c99aa"
      }
    }
  }
}
